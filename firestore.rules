rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isAdmin(uid) { return signedIn() && (request.auth.uid == uid || userDoc(uid).role == 'admin'); }
    match /users/{uid} { allow read, write: if self(uid); match /{collection}/{docId} { allow read: if self(uid) || isAdmin(uid); allow create, update, delete: if isAdmin(uid); } }
    match /propriedades/{code} { allow read: if signedIn(); allow write: if signedIn() && request.resource.data.adminUid == request.auth.uid; }
    match /convitesPendentes/{id} { allow read, write: if signedIn(); }
  }
}
